#!/usr/bin/env python3
"""Land a branch on main: main moves when the branch's runs on GitHub are green.

  ./land <branch>            every step below, in order
  ./land --green <branch>    push the branch and wait until its runs are green
  ./land --merge <branch>    fast-forward main to it, in the main checkout
  ./land --push <branch>     push main, then delete the branch here and on GitHub

  --as <name>   push the branch under this name, for a worktree's own branch.
                Only the pushed branch is deleted then: the worktree's stays.
                Give it to every step.

A step that cannot finish stops the run, and no later step happens. Nothing is
deleted before main is on GitHub. A step alone is for work that has something
to do between two of them, such as copying git-ignored files in after --merge.

--green refuses a branch that does not hold origin's main: rebase it, run the
suites on the rebased commit, and land again. It replaces what this clone
last pushed under the name, and nothing else. --merge takes only the commit
that is on GitHub under the name with every run green; it runs in the main
checkout, from any worktree, while that checkout is on main. --push deletes
the pushed branch only while it still holds that commit.

Needs git, and gh (logged in) for --green.
"""

import json
import subprocess
import sys
import time

MAIN = "main"
# How long GitHub may take to start a pushed commit's runs, and how often to ask.
RUNS_START_TIMEOUT = 180
RUNS_START_INTERVAL = 5


class Stopped(Exception):
    pass


def said(result):
    """What a command that failed said."""
    return (result.stderr or result.stdout).strip()


def git(*args, cwd=None, check=True):
    """Run git; its output, or None when it fails and `check` is off."""
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if result.returncode != 0:
        if check:
            raise Stopped(f"git {' '.join(args)}: {said(result)}")
        return None
    return result.stdout.strip()


def holds(commit, other, cwd=None):
    """Whether `commit` holds `other`: `other` is `commit` or one of its ancestors."""
    return git("merge-base", "--is-ancestor", other, commit, cwd=cwd, check=False) is not None


def on_origin(branch):
    """The commit origin has for `branch`, asked of origin itself, or None."""
    listed = git("ls-remote", "origin", f"refs/heads/{branch}")
    return listed.split()[0] if listed else None


def main_checkout():
    """The repository's first checkout, which the others are worktrees of."""
    return git("worktree", "list", "--porcelain").splitlines()[0].split(" ", 1)[1]


def fail_unless_holds_main(branch, commit):
    git("fetch", "-q", "origin", MAIN)
    if not holds(commit, on_origin(MAIN)):
        raise Stopped(f"main has moved: {branch} does not hold origin's main. rebase {branch} on main, "
                      "run the suites on the rebased commit, and land again")


def runs_of(name, commit):
    listed = subprocess.run(["gh", "run", "list", "--branch", name, "--commit", commit, "--limit", "50",
                             "--json", "databaseId,name,status,conclusion"], capture_output=True, text=True)
    if listed.returncode != 0:
        raise Stopped(f"gh run list: {listed.stderr.strip()}")
    return json.loads(listed.stdout)


def fail_unless_green(branch, commit, pushed_as):
    """The commit is on origin under its pushed name, and every run of it has
    ended green. Return the runs."""
    if on_origin(pushed_as) != commit:
        raise Stopped(f"origin's {pushed_as} is not at {commit[:7]}, where {branch} is: run ./land --green {branch}")
    runs = runs_of(pushed_as, commit)
    red = [run for run in runs if run["status"] != "completed" or run["conclusion"] != "success"]
    if red or not runs:
        raise Stopped("\n".join(f"{run['name']} ended in {run['conclusion'] or run['status']}: gh run view "
                                f"{run['databaseId']} --log-failed" for run in red)
                      or f"GitHub has no run for {pushed_as} at {commit[:7]}: run ./land --green {branch}")
    return runs


def green(branch, commit, pushed_as):
    """Push the branch as `pushed_as` and wait until every run of its commit is green."""
    fail_unless_holds_main(branch, commit)
    # With no value the lease is this clone's own record of origin's branch:
    # what it last pushed there, or no branch at all.
    pushed = subprocess.run(["git", "push", "-q", f"--force-with-lease=refs/heads/{pushed_as}", "origin",
                             f"{commit}:refs/heads/{pushed_as}"], capture_output=True, text=True)
    if pushed.returncode != 0:
        raise Stopped(f"origin's {pushed_as} is not what this clone last pushed there, so it stays. Look at it "
                      f"(git fetch origin {pushed_as}), or push under another name with --as.\n{said(pushed)}")
    deadline = time.monotonic() + RUNS_START_TIMEOUT
    while not (runs := runs_of(pushed_as, commit)):
        if time.monotonic() > deadline:
            raise Stopped(f"GitHub started no run for {pushed_as} at {commit[:7]} in {RUNS_START_TIMEOUT}s")
        time.sleep(RUNS_START_INTERVAL)
    while going := [run for run in runs if run["status"] != "completed"]:
        # Its exit status says how that run ended; the list says it for all.
        subprocess.run(["gh", "run", "watch", str(going[0]["databaseId"]), "--exit-status"], capture_output=True)
        runs = runs_of(pushed_as, commit)
    runs = fail_unless_green(branch, commit, pushed_as)
    print(f"green: {pushed_as} at {commit[:7]} ({', '.join(run['name'] for run in runs)})")


def merge(branch, commit, pushed_as):
    """Fast-forward main, in the main checkout, to the commit whose runs were green."""
    fail_unless_green(branch, commit, pushed_as)
    fail_unless_holds_main(branch, commit)
    checkout = main_checkout()
    current = git("symbolic-ref", "--short", "-q", "HEAD", cwd=checkout, check=False)
    if current != MAIN:
        raise Stopped(f"the main checkout is on {current or 'no branch'}, not {MAIN}: switch it back, or when "
                      "another session is committing there, try again in a minute")
    git("merge", "-q", "--ff-only", commit, cwd=checkout)
    print(f"merged: {MAIN} is at {commit[:7]} in {checkout}")


def push(branch, commit, pushed_as):
    """Push main; once origin has it, delete the pushed branch while it still
    holds the commit, and the local one when it was pushed under its own name."""
    checkout = main_checkout()
    if not holds(MAIN, commit, cwd=checkout):
        raise Stopped(f"{MAIN} does not hold {branch}: run ./land --merge {branch} first")
    git("push", "-q", "origin", MAIN, cwd=checkout)
    landed = git("rev-parse", MAIN, cwd=checkout)
    if on_origin(MAIN) != landed:
        raise Stopped(f"origin's {MAIN} is not at {landed[:7]} after the push")
    print(f"pushed: origin's {MAIN} is at {landed[:7]}")
    # Under a lease on the commit: a branch that holds anything else stays.
    deleted = subprocess.run(["git", "push", "-q", f"--force-with-lease=refs/heads/{pushed_as}:{commit}", "origin",
                              f":refs/heads/{pushed_as}"], capture_output=True, text=True)
    if deleted.returncode != 0 and on_origin(pushed_as):
        print(f"kept: origin's {pushed_as}, which is not at {commit[:7]}")
    if pushed_as == branch:
        # git refuses while a worktree is on the branch: it stays then.
        deleted = subprocess.run(["git", "branch", "-d", branch], cwd=checkout, capture_output=True, text=True)
        if deleted.returncode != 0:
            print(f"kept: {branch}: {said(deleted)}")


def main(args):
    steps = [arg for arg in args if arg in ("--green", "--merge", "--push")]
    rest = [arg for arg in args if arg not in steps]
    pushed_as = None
    if "--as" in rest[:-1]:
        at = rest.index("--as")
        pushed_as = rest[at + 1]
        del rest[at:at + 2]
    if len(rest) != 1 or rest[0].startswith("-") or len(steps) > 1:
        print(__doc__.strip())
        return 0 if set(args) & {"-h", "--help"} else 2
    branch = rest[0]
    pushed_as = pushed_as or branch
    try:
        if MAIN in (branch, pushed_as):
            raise Stopped(f"{MAIN} is where a branch lands: name the branch to land")
        commit = git("rev-parse", "--verify", "-q", f"refs/heads/{branch}", check=False)
        if not commit:
            raise Stopped(f"{branch}: no such branch here")
        if steps in ([], ["--green"]):
            green(branch, commit, pushed_as)
        if steps in ([], ["--merge"]):
            merge(branch, commit, pushed_as)
        if steps in ([], ["--push"]):
            push(branch, commit, pushed_as)
    except Stopped as stopped:
        print(f"land: {stopped}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
