{
  "lastChangelogVersion": "1.5.2",
  "theme": "dracula-pro",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "hideThinkingBlock": false,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "packages": [
    "npm:pi-mcp-adapter@2.36.0",
    "./local-packages/pi-subagents",
    {
      "source": "./local-packages/rpiv-ask-user-question",
