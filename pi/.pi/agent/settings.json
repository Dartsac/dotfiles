{
  "lastChangelogVersion": "1.6.0",
  "theme": "dracula-pro",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "hideThinkingBlock": false,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "packages": [
    "./local-packages/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
    "./local-packages/pi-web-access",
    {
      "source": "npm:@mtrojnar/pi-usage",
      "extensions": []
    },
    "npm:pi-rewind",
    "git:github.com/nicobailon/visual-explainer",
    "npm:pi-schedule-prompt"
  ],
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "enabled": true
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "anthropic/claude-haiku-5-5",
        "thinking": "low"
      }
    },
    "agentOverridesByProvider": {
      "anthropic": {
        "reviewer": {
          "model": "openai-codex/gpt-6.1-sol"
        }
      },
      "openai-codex": {
        "reviewer": {
          "model": "anthropic/claude-opus-5-5"
        }
      }
    }
  },
  "extensions": [
    "-extensions/herdr-agent-state.ts"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"./local-packages/pi-subagents\",\"scope\":\"user\"}": "0.88.1",
    "{\"source\":\"./local-packages/pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"git:github.com/nicobailon/visual-explainer\",\"scope\":\"user\"}": "0.15.0",
    "{\"source\":\"npm:pi-schedule-prompt\",\"scope\":\"user\"}": "0.5.1"
  },
  "defaultThinkingLevel": "high"
}