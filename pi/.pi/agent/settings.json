        "+index.ts"
      ]
    },
    "./local-packages/pi-web-access",
    {
      "source": "npm:@mtrojnar/pi-usage",
      "extensions": []
    },
    "npm:pi-rewind"
  ],
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "enabled": true
      }
    }
  },
  "extensions": [
    "-builtin:mcp",
    "-extensions/herdr-agent-state.ts"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter@2.36.0\",\"scope\":\"user\"}": "2.36.0",
    "{\"source\":\"./local-packages/pi-subagents\",\"scope\":\"user\"}": "0.70.1",
    "{\"source\":\"./local-packages/pi-web-access\",\"scope\":\"user\"}": "0.30.0"
  },
  "defaultThinkingLevel": "high"
}