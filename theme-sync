#!/usr/bin/env python3
"""Install the Dracula PRO theme from the downloaded package into each app.

Dracula PRO is a paid theme, so its colors are never stored in this
repository. This script reads them from the package on this machine and writes
files outside the repository or ignored by git:

  ~/.local/share/theme-sync/palette.json   named colors for every variant, and
                                            the package's other values (for the guards)
  ~/.config/ghostty/themes/Dracula-*       the package's Ghostty themes
  ~/.local/share/nvim/site/pack/themes/start/dracula-pro   the package's Vim theme
  each target in theme-templates.txt       its template with {{names}} filled in
  ~/Library/Fonts/HerdrSpritesPixel-*.ttf   Herdr's state-colored sprite fonts
                                            (named for their drawings; old ones go)

To theme another app, write its config in this repository with color names in
double braces ({{orange}}, {{bgdark}}; `theme-sync --names` lists them), add a
`template -> target` line to theme-templates.txt, and run theme-sync.
For a shade between two colors, {{comment+foreground:40}} is comment with 40%
foreground mixed in.

Run it after downloading a new package, on a new machine, after editing a
template, or after switching the Ghostty theme variant.

Package: $DRACULA_PRO_DIR, else the newest dracula-pro-v* directory under
~/Documents/Resources/Themes/Dracula Packages. It must contain
design/palette.md, themes/ghostty and themes/vim (v2.2 or newer). Without a
package only the templates are written, with stand-in colors.

  theme-sync                 install everything
  theme-sync --check         report what would change; write nothing
  theme-sync --names         list the color names templates can use
  theme-sync --check-staged  fail if staged changes contain a Dracula PRO
                             color value (run by the git pre-commit hook)
  theme-sync --check-history fail if any commit reachable from any ref holds
                             one; names commit and file, never the value
"""

import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
PACKAGES = HOME / "Documents/Resources/Themes/Dracula Packages"
PALETTE_JSON = HOME / ".local/share/theme-sync/palette.json"
GHOSTTY = HOME / ".config/ghostty"
NVIM_THEME = HOME / ".local/share/nvim/site/pack/themes/start/dracula-pro"
REPO = Path(__file__).resolve().parent
TEMPLATES = REPO / "theme-templates.txt"
# {{name}}, or {{name+other:percent}} for a blend of two colors.
TOKEN = re.compile(r"\{\{([a-z_]+)(?:\+([a-z_]+):(\d{1,2}))?\}\}")
# A color value in text: ("#" or "", six hex digits).
COLOR_VALUE = re.compile(r"(?<![0-9A-Za-z])(#?)([0-9A-Fa-f]{6})(?![0-9A-Za-z])")
# The name the guards give a package value that no palette names.
UNNAMED = "unnamed"

# Stand-in colors for templates when no package is installed (One Dark, a
# free palette). Other names resolve by family: see stand_in().
STAND_INS = {
    "background": "#282c34",
    "foreground": "#abb2bf",
    "comment": "#5c6370",
    "selection": "#3e4451",
    "cursor": "#528bff",
    "black": "#282c34",
    "white": "#abb2bf",
    "red": "#e06c75",
    "green": "#98c379",
    "yellow": "#e5c07b",
    "blue": "#61afef",
    "magenta": "#c678dd",
    "cyan": "#56b6c2",
    "orange": "#d19a66",
    "purple": "#61afef",
    "pink": "#c678dd",
    "bg": "#282c34",
    "bgdark": "#21252b",
    "bgdarker": "#21252b",
    "bglight": "#2c313a",
    "bglighter": "#2c313a",
}
# The free Dracula theme's published colors (draculatheme.com/spec: standard,
# ANSI and UI palettes). Dracula PRO shares a few; those are public, not paid.
FREE_DRACULA = {
    "282a36", "6272a4", "44475a", "f8f8f2", "ff5555", "ffb86c", "f1fa8c", "50fa7b",
    "8be9fd", "bd93f9", "ff79c6", "353747", "21222c", "ff6e6e", "69ff94", "ffffa5",
    "d6acff", "ff92df", "a4ffff", "343746", "424450", "191a21",
}
# Target suffixes whose format takes a "#" comment, for the generated-file note.
HASH_COMMENTS = {".toml", ".yml", ".yaml", ".conf", ".ini", ".fish", ".sh"}
HOOK = """#!/bin/sh
# Installed by theme-sync: refuse commits that add Dracula PRO color values,
# and commits of a pi extension whose tests fail.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$top/theme-sync" ] || exit 0
# Checkouts from before the guard existed have a theme-sync without it.
grep -q -e --check-staged "$top/theme-sync" || exit 0
"$top/theme-sync" --check-staged || exit 1
# Checkouts from before the extension tests existed have no runner.
[ -f "$top/tests/pi-extensions.mjs" ] && command -v node >/dev/null 2>&1 || exit 0
exec node "$top/tests/pi-extensions.mjs" --staged
"""


def version_key(path):
    return [int(n) for n in re.findall(r"\d+", path.name)]


def find_package():
    """The package directory, or (None, why)."""
    override = os.environ.get("DRACULA_PRO_DIR")
    if override:
        candidates = [Path(override).expanduser()]
    else:
        candidates = sorted(PACKAGES.glob("dracula-pro-v*"), key=version_key, reverse=True)
    if not candidates:
        return None, f"no dracula-pro-v* directory in {PACKAGES}"
    package = candidates[0]
    missing = [p for p in ("design/palette.md", "themes/ghostty", "themes/vim/colors") if not (package / p).exists()]
    if missing:
        return None, f"{package} lacks {', '.join(missing)} (needs Dracula PRO v2.2 or newer)"
    return package, None


def snake(name):
    """BrightBlue -> bright_blue."""
    return re.sub(r"(?<=[a-z])(?=[A-Z])", "_", name.strip()).lower().replace(" ", "_")


def read_palettes(package):
    """{variant: {name: "#rrggbb"}} from palette.md and the Vim theme."""
    text = (package / "design/palette.md").read_text()
    _, _, terminal = text.partition("# Color Palette - Terminal Standard")
    sections, variant = {}, None
    for line in terminal.splitlines():
        heading = re.match(r"##\s+(?:Dracula PRO - )?(.+?)\s*$", line)
        if heading:
            variant = heading.group(1).lower().replace(" ", "-")
            variant = "pro" if variant == "base" else variant
            sections[variant] = {}
            continue
        row = re.match(r"\|\s*([A-Za-z ]+?)\s*\|\s*`(#[0-9A-Fa-f]{6})`", line)
        if row and variant:
            sections[variant][snake(row.group(1))] = row.group(2).lower()
    if "pro" not in sections:
        raise SystemExit("theme-sync: palette.md has no 'Dracula PRO - Base' terminal section")
    palettes = {}
    for variant, colors in sections.items():
        merged = {**sections["pro"], **colors}  # variants list only what differs
        stem = "dracula-pro" if variant == "pro" else f"dracula-pro-{variant}"
        vim = package / "themes/vim/colors" / f"{stem}.vim"
        if vim.exists():  # background shades exist only in the Vim theme
            for name, value in re.findall(r"palette\.(bg\w*)\s*=\s*\['(#[0-9A-Fa-f]{6})'", vim.read_text()):
                merged[name] = value.lower()
        merged.update(purple=merged["blue"], pink=merged["magenta"])  # the theme's own names
        palettes[variant] = merged
    return palettes


def ghostty_variant():
    """Variant named by Ghostty's last `theme =` line: Dracula-Van-Helsing -> van-helsing."""
    try:
        lines = (GHOSTTY / "config").read_text().splitlines()
    except OSError:
        return "pro"
    names = [m.group(1) for m in (re.match(r"\s*theme\s*=\s*(\S+)", line) for line in lines) if m]
    if not names or "-" not in names[-1]:
        return "pro"
    return names[-1].split("-", 1)[1].lower()


def stand_in(name):
    """Stand-in color for a name: bright_red and dim_red use red's."""
    return STAND_INS.get(name) or STAND_INS.get(re.sub(r"^(bright|dim)_", "", name))


def read_templates():
    """[(template path, target path)] from theme-templates.txt."""
    pairs = []
    for number, line in enumerate(TEMPLATES.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        source, arrow, target = (part.strip() for part in line.partition("->"))
        if not arrow or not source or not target:
            raise SystemExit(f"theme-sync: {TEMPLATES.name} line {number}: expected 'template -> target'")
        pairs.append((REPO / source, Path(target).expanduser()))
    return pairs


def blend(color, other, percent):
    """color with percent% of other mixed in, channel by channel."""
    channels = zip(bytes.fromhex(color[1:]), bytes.fromhex(other[1:]))
    return "#" + "".join(f"{round(a + (b - a) * percent / 100):02x}" for a, b in channels)


def render(template, target, colors):
    """Template text with each {{name}} replaced; colors=None uses stand-ins."""
    lookup = colors.get if colors is not None else stand_in
    text = template.read_text()
    used = {name for match in TOKEN.findall(text) for name in match[:2] if name}
    unknown = sorted(name for name in used if not lookup(name))
    if unknown:
        raise SystemExit(f"theme-sync: {template.relative_to(REPO)} uses unknown color names: {', '.join(unknown)}")

    def color(match):
        name, other, percent = match.groups()
        return blend(lookup(name), lookup(other), int(percent)) if other else lookup(name)

    text = TOKEN.sub(color, text)
    if target.suffix in HASH_COMMENTS:
        text = f"# GENERATED by theme-sync from {template.relative_to(REPO)}. Edit that file, then run theme-sync.\n" + text
    return text


def install_hook(install):
    """Put the pre-commit guard where this repository's git looks for hooks."""
    def git(*args):
        return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True, text=True).stdout.strip()

    hooks = git("config", "core.hooksPath")
    hooks = Path(hooks).expanduser() if hooks else Path(git("rev-parse", "--git-common-dir")) / "hooks"
    if not hooks.is_absolute():
        hooks = REPO / hooks
    hook = hooks / "pre-commit"
    if hook.exists() and "theme-sync" not in hook.read_text():
        print(f"theme-sync: {hook} is another hook; add `theme-sync --check-staged` to it yourself")
        return
    install.write(hook, HOOK, mode=0o755)


def other_values(package, palettes):
    """Sorted "#rrggbb" values in the package's text files that no palette names.

    Its app themes (Emacs, for one) carry shades beyond palette.md."""
    named = {value for palette in palettes.values() for value in palette.values()}
    found = set()
    for path in package.rglob("*"):
        data = path.read_bytes() if path.is_file() else b"\0"
        if b"\0" not in data:
            found.update("#" + value.lower() for mark, value in COLOR_VALUE.findall(data.decode(errors="replace")) if mark)
    return sorted(found - named)


def package_colors():
    """{"rrggbb": name} for the package's own values in palette.json, or None.

    Values with no palette name are named UNNAMED."""
    try:
        stored = json.loads(PALETTE_JSON.read_text())
        variants = stored["variants"]
    except (OSError, ValueError, KeyError):
        return None
    names = {}
    for palette in variants.values():
        for name, value in palette.items():
            names.setdefault(value[1:].lower(), name)
    for value in stored.get("other_values", []):
        names.setdefault(value[1:].lower(), UNNAMED)
    # Greys (white and black included) and free Dracula colors are not specific to the theme.
    return {
        value: name for value, name in names.items()
        if value not in FREE_DRACULA and not value[0:2] == value[2:4] == value[4:6]
    }


def colors_in(text, names):
    """Names of the package colors whose values appear in text."""
    found = []
    for mark, value in COLOR_VALUE.findall(text):
        # Six digits without "#" are far more often a number than a color.
        if value.lower() in names and (mark or not value.isdigit()):
            found.append(names[value.lower()])
    return found


def check_history():
    """Exit 1 if any commit reachable from any ref holds a package color value."""
    names = package_colors()
    if names is None:
        raise SystemExit(f"theme-sync: cannot check history without {PALETTE_JSON}; run theme-sync with the package installed")

    def git(*args):
        return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout

    blobs = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    colors_by_blob = {}

    def blob_colors(blob):
        if blob not in colors_by_blob:
            blobs.stdin.write(blob.encode() + b"\n")
            blobs.stdin.flush()
            size = int(blobs.stdout.readline().split()[2])
            data = blobs.stdout.read(size + 1)[:-1]
            # Like git grep, skip binary files.
            colors_by_blob[blob] = [] if b"\0" in data else colors_in(data.decode(errors="replace"), names)
        return colors_by_blob[blob]

    found = []
    for commit in git("rev-list", "--all").split():
        for entry in git("ls-tree", "-r", "-z", commit).split("\0"):
            if not entry:
                continue
            meta, path = entry.split("\t", 1)
            _, kind, blob = meta.split()
            colors = blob_colors(blob) if kind == "blob" else []
            if colors:
                found.append(f"  {commit[:12]} {path}: {', '.join(sorted(set(colors)))}")
    blobs.stdin.close()
    blobs.wait()
    if found:
        print("theme-sync: commits contain Dracula PRO color values (paid theme, keep out of git):")
        print("\n".join(found))
        return 1
    print("theme-sync: no commit contains a Dracula PRO color value")
    return 0


def check_staged():
    """Exit 1 if staged additions contain a color value from palette.json."""
    names = package_colors()
    if names is None:
        return 0  # no package on this machine: nothing to compare against
    diff = subprocess.run(["git", "diff", "--cached", "-U0", "--no-color"], capture_output=True, text=True).stdout
    found, path, line_number = [], None, 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@"):
            line_number = int(re.search(r"\+(\d+)", line).group(1)) - 1
        elif line.startswith("+") and path:
            line_number += 1
            for name in colors_in(line[1:], names):
                hint = "remove it (no template name)" if name == UNNAMED else f"use {{{{{name}}}}} in a template instead"
                found.append(f"  {path}:{line_number}: {hint}")
    if found:
        print("theme-sync: staged changes contain Dracula PRO color values (paid theme, keep out of git):")
        print("\n".join(found))
        print("See the theme-sync header for templates. To commit anyway: git commit --no-verify")
        return 1
    return 0


class Installer:
    def __init__(self, check):
        self.check = check
        self.changed = []

    def write(self, path, text, mode=None):
        """Write a regular file, replacing a stale symlink if one is there."""
        if path.exists() and not path.is_symlink() and path.read_text() == text:
            return
        self.changed.append(str(path))
        if not self.check:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.name + ".tmp")
            tmp.write_text(text)
            if mode:
                tmp.chmod(mode)
            tmp.replace(path)

    def copy_tree(self, source, target):
        def listing(root):
            return {p.relative_to(root): p.read_bytes() for p in sorted(root.rglob("*")) if p.is_file() and p.name != ".DS_Store"}

        if target.exists() and listing(source) == listing(target):
            return
        self.changed.append(str(target))
        if not self.check:
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(source, target, ignore=shutil.ignore_patterns(".DS_Store"))


def install_herdr_fonts(install, colors):
    """Generate color sprites outside git from the same palette as the config.

    fontTools is needed only here; uv supplies it if this Python lacks it.
    The colorless source fonts in git remain untouched."""
    builder = REPO / "herdr/.config/herdr/faces/color_font.py"
    if not builder.exists() or sys.platform != "darwin":
        return
    if importlib.util.find_spec("fontTools"):
        python = [sys.executable]
    elif shutil.which("uv"):
        python = ["uv", "run", "--quiet", "--with", "fonttools", "python"]
    else:
        raise SystemExit("theme-sync: install uv or Python fonttools to generate Herdr's color sprites")
    args = python + ["-B", str(builder), "--output", str(HOME / "Library/Fonts")]
    if install.check:
        args.append("--check")
    # Include aliases such as dim_green even with the stand-in palette.
    palette = colors if colors is not None else {n: stand_in(n) for n in set(STAND_INS) | {"dim_green", "bright_blue", "dim_white"}}
    result = subprocess.run(args, input=json.dumps(palette), capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise SystemExit("theme-sync: color font generation failed:\n" + result.stderr)
    install.changed.extend(json.loads(result.stdout))


def main():
    if sys.argv[1:] == ["--check-staged"]:
        raise SystemExit(check_staged())
    if sys.argv[1:] == ["--check-history"]:
        raise SystemExit(check_history())
    if sys.argv[1:] not in ([], ["--check"], ["--names"]):
        raise SystemExit(__doc__)
    install = Installer(check=sys.argv[1:] == ["--check"])
    package, why = find_package()
    colors = None
    if sys.argv[1:] == ["--names"]:
        print("\n".join(sorted(read_palettes(package)["pro"] if package else STAND_INS)))
        return
    if package:
        palettes = read_palettes(package)
        variant = ghostty_variant()
        if variant not in palettes:
            print(f"theme-sync: Ghostty variant '{variant}' is not in the package; using 'pro'")
            variant = "pro"
        colors = palettes[variant]
        stored = {"package": package.name, "variants": palettes, "other_values": other_values(package, palettes)}
        install.write(PALETTE_JSON, json.dumps(stored, indent=1, sort_keys=True) + "\n")
        for theme in sorted((package / "themes/ghostty").iterdir()):
            if theme.is_file() and "." not in theme.name:
                name = "Dracula-" + "-".join(part.capitalize() for part in theme.name.split("-"))
                install.write(GHOSTTY / "themes" / name, theme.read_text())
        install.copy_tree(package / "themes/vim", NVIM_THEME)
        print(f"theme-sync: {package.name}, variant '{variant}'")
    else:
        print(f"theme-sync: no Dracula PRO package ({why}); app themes left as they are")

    # Prepare the color font before a generated config can refer to it.
    install_herdr_fonts(install, colors)
    for template, target in read_templates():
        stray = template.with_name(target.name)
        if stray.exists() and stray.resolve() != target.resolve():
            print(f"theme-sync: {stray.relative_to(REPO)} is not read by anything; edit {template.name} instead and delete it")
        before = len(install.changed)
        install.write(target, render(template, target, colors))
        if target.parent.name == "herdr" and len(install.changed) > before and not install.check and shutil.which("herdr"):
            subprocess.run(["herdr", "server", "reload-config"], capture_output=True, timeout=10)
    install_hook(install)

    verb = "would update" if install.check else "updated"
    for path in install.changed:
        print(f"  {verb} {path}")
    if not install.changed:
        print("  everything is up to date")


if __name__ == "__main__":
    main()
