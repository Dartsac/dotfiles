# Fish uses a whole-directory symlink; keep machine-local/generated files untracked.
fish/.config/fish/config-local.fish
fish/.config/fish/fish_variables
fish/.config/fish/fish_greeting_last_run
fish/.config/fish/completions/fabric.fish
fish/.config/fish/completions/copilot.fish
# Neovim's local override (example: lua/config/local.example.lua)
nvim/.config/nvim/lua/config/local.lua
# Every other local override, by its name: <name>.local.<suffix>, beside a
# tracked <name>.local.example.<suffix> (tmux.local.conf, projects.local.txt).
# Name a new one this way and git ignores it before its commit reaches main.
*.local.*
!*.local.example.*

# Python bytecode (the herdr scripts import herdr_cli.py)
__pycache__/

# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex


nvim/.config/nvim/plugin
.DS_Store
nvim/.config/nvim/doc
nvim/.config/nvim/colors
nvim/.config/nvim/autoload
# Written by theme-sync from the Dracula PRO package (paid theme), keep local
ghostty/.config/ghostty/themes/
herdr/.config/herdr/config.toml
# Local Herdr runtime state, retained when its config directory is symlinked.
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/plugins/
herdr/.config/herdr/plugins.json
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/
herdr/.config/herdr/sessions/
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/*.sock.agent
# Karabiner's profile and the timestamped copies it rewrites on its own, where
# ~/.config/karabiner links into the clone (stowed before --no-folding): each
# machine keeps its own (its devices, the owner's Command+M rule). The package
# ships only the rules in assets/complex_modifications.
/karabiner/.config/karabiner/karabiner.json
/karabiner/.config/karabiner/automatic_backups/

# Tide prompt settings: contain Dracula Pro colors (paid theme), keep local
fish/.config/fish/tide-theme.private.fish
